{
  "multipart": [
    { "when": { "down": "true" }, "apply": { "model": "tribalpower:block/song_vine" } },
    { "when": { "up": "true" }, "apply": { "model": "tribalpower:block/song_vine", "x": 180 } },
    { "when": { "north": "true" }, "apply": { "model": "tribalpower:block/song_vine", "x": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "tribalpower:block/song_vine", "x": 90, "y": 180 } },
    { "when": { "west": "true" }, "apply": { "model": "tribalpower:block/song_vine", "x": 90, "y": 270 } },
    { "when": { "east": "true" }, "apply": { "model": "tribalpower:block/song_vine", "x": 90, "y": 90 } }
  ]
}
